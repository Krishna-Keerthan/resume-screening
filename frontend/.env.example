# =============================================================================
# frontend/.env.example - AI Resume Screening Platform (Next.js)
# =============================================================================
# SETUP
#   cp .env.example .env.local        (run from frontend/)
#   npm install && npm run dev        -> http://localhost:3000
#
# The browser never calls the backend directly. It calls /api/v1/* on this app's own
# domain and next.config.js rewrites those requests to API_PROXY_TARGET. That keeps the
# refresh-token cookie first-party (no CORS, no custom domain). There is no
# NEXT_PUBLIC_API_URL: nothing about the backend's address reaches the browser.
#
# NEVER commit .env.local. Production values live in Vercel (Project Settings ->
# Environment Variables) and in docker-compose.yml, not in this file.
# =============================================================================


# --- Backend address (REQUIRED to build for production) ------------------------------------
# The backend ORIGIN, without /api/v1 and without a trailing slash.
#   Local backend:           http://localhost:5000
#   Inside docker compose:   http://ats_flask:5000   (set by docker-compose.yml)
#   Production (Vercel):     https://<your-service>.onrender.com
#
# Rewrites are fixed at BUILD time: set it where `next build` runs (Vercel, the docker
# build arg) and rebuild after changing it. `next build` fails with a clear message if
# it is unset, or if it ends in /api/v1. `next dev` falls back to http://localhost:5000.
API_PROXY_TARGET=http://localhost:5000


# --- Optional ----------------------------------------------------------------------------------
# localStorage key under which the signed-in user's role and name are persisted.
# Change it only to keep two deployments on one domain from sharing state.
# NEXT_PUBLIC_AUTH_STORAGE_KEY=ats-auth-v1
