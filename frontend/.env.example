# Copy to .env.local for local development (docker compose reads it as well).
#
# Backend origin WITHOUT /api/v1. The browser calls /api/v1/* on this app's own
# domain and next.config.js rewrites it here, which keeps the refresh cookie
# first-party. Rewrites are fixed at BUILD time: set it where `next build` runs
# (Vercel project settings, the docker build arg) and rebuild after changing it.
# A production build fails if it is unset.
API_PROXY_TARGET=http://localhost:5000

# localStorage key for the persisted auth state (optional).
# NEXT_PUBLIC_AUTH_STORAGE_KEY=ats-auth-v1
