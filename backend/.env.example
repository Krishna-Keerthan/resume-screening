# =============================================================================
# backend/.env.example - AI Resume Screening Platform (Flask API)
# =============================================================================
# SETUP
#   cp .env.example .env        (run from backend/)
#   Fill in the REQUIRED values below, then run the app:
#     - WSL / Linux: flask or gunicorn, see the README and docs/deploy_phase3.md
#     - Docker:      docker compose up   (from the repo root; compose overrides DATABASE_URL)
#
# REQUIRED to start:  SECRET_KEY, DATABASE_URL
# REQUIRED in production (APP_ENV=production), or the app refuses to start:
#   SECRET_KEY (64-char random hex), DATABASE_URL, a shared RATE_LIMIT_STORAGE_URL
#   (redis://...), and the three CLOUDINARY_* values when STORAGE_PROVIDER=cloudinary.
# Everything else has a working default; the values below are those defaults.
#
# NEVER commit a real .env file. It is listed in .gitignore.
# Production values live in the Render dashboard / render.yaml, not in this file.
# =============================================================================


# --- Environment -------------------------------------------------------------
# development | production | testing
APP_ENV=development


# --- Security ----------------------------------------------------------------
# REQUIRED. The secret that signs access and refresh tokens (JWT).
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
# Local dev: any string of 32+ characters. Production: 64-char hex, set in Render.
SECRET_KEY=

# Token lifetimes. The access token is short because it cannot be revoked; the
# refresh cookie's Max-Age follows JWT_REFRESH_TTL_DAYS.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7


# --- Server ------------------------------------------------------------------
# Used by `python run.py` and by gunicorn.conf.py (Render sets PORT itself).
HOST=0.0.0.0
PORT=5000

# Gunicorn worker count. Production defaults to 1 (this setting is not needed there):
# the app plus its embedding model measured 470-500 MB with one worker and 538 MB
# with two, against Render's 512 MB (docs/deploy_phase3.md). Development defaults to 2.
WORKERS=1

# Longest gunicorn lets a request run. The timeout chain, innermost first:
#   one Groq call (GROQ_CALL_BUDGET_SECONDS 100) < axios 110 < this 115 < Vercel's proxy 120
GUNICORN_TIMEOUT_SECONDS=115


# --- Database ----------------------------------------------------------------
# REQUIRED. SQLAlchemy URL for PostgreSQL.
#   Local PostgreSQL:        postgresql://postgres:ats_pass@localhost:5432/ats_db
#   Inside docker compose:   set by docker-compose.yml (host ats_postgres), ignore this
#   Production (Render):     injected from the attached database (render.yaml)
# Render may give postgres:// - the app rewrites it to postgresql:// for SQLAlchemy 2.
# Development and tests create missing tables on startup; production does not:
# the Render start command runs `alembic upgrade head` first.
DATABASE_URL=postgresql://postgres:ats_pass@localhost:5432/ats_db

# Connection pool, per gunicorn worker. Leave the defaults unless you know why.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30


# --- CORS ---------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (protocol + host + port).
# In production the browser talks to the Vercel domain and Next.js proxies /api/v1/*
# here, so this only matters for tools that call the API directly. Never use *.
#   Production: ALLOWED_ORIGINS=https://your-project.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Seconds a browser may cache a preflight response (Access-Control-Max-Age).
CORS_MAX_AGE=600


# --- Reverse proxy and refresh cookie -----------------------------------------
# Production sits behind Vercel (which proxies /api/v1/* here) and then Render's own
# proxy. TRUSTED_PROXY_HOPS is how many of them append to X-Forwarded-For; the client
# IP is the entry that many places from the right. Too low: every user shares one
# rate-limit bucket. Too high: a caller can choose their own bucket.
# 0 (development) ignores the header. Production defaults to 2 - verify it after the
# first deploy (docs/deploy_phase3.md).
TRUSTED_PROXY_HOPS=0

# TEMPORARY: log the forwarded chain on each login so the hop count can be checked
# against the real deployment. Remove once verified.
LOG_PROXY_CHAIN=false

# The refresh cookie's Secure flag. Production defaults to true; development over
# plain http needs false.
REFRESH_COOKIE_SECURE=false


# --- File uploads and storage ---------------------------------------------------
# Folder for the local storage provider.
UPLOAD_FOLDER=uploads/
# Largest accepted upload, in megabytes.
MAX_UPLOAD_MB=10
# Accepted extensions (comma-separated, no dots).
ALLOWED_EXTENSIONS=pdf,docx

# Resume parsing limits.
# Seconds one parse may take before it is abandoned.
PARSE_TIMEOUT_SECONDS=30
# Parsed text beyond this many characters is cut off.
MAX_PARSED_TEXT_CHARS=200000
# Parses allowed at once per worker; more requests get "parser busy" (503).
PARSE_CONCURRENCY=2

# Seconds a signed resume download link stays valid.
DOWNLOAD_URL_TTL_SECONDS=300

# local (development) | supabase | cloudinary (being replaced by supabase)
# Production must not use local: Render's disk is wiped on every deploy.
STORAGE_PROVIDER=local

# Needed when STORAGE_PROVIDER=supabase. All three must be set or the app refuses to start.
# SUPABASE_URL is the project's base URL, https://<project>.supabase.co (no path).
# SUPABASE_BUCKET is a PRIVATE bucket with no public policy.
# SUPABASE_SERVICE_ROLE_KEY (Project Settings -> API) bypasses row-level security: server-side
# only, set it in the Render dashboard, never in the frontend, a commit or a log.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=
# Needed when STORAGE_PROVIDER=cloudinary. All three must be set or the app refuses
# to start. Get them from the Cloudinary dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder inside your Cloudinary account.
CLOUDINARY_FOLDER=resumes


# --- Rate limiting ---------------------------------------------------------------
# Limits are per caller: the user id from the access token, else the client IP.
# memory:// keeps counters per process - fine for local development. Production needs
# a shared store, e.g. redis://:password@host:6379/0 (Render Key Value), and the app
# refuses to start with memory:// there.
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_DEFAULT=200 per minute
# Login must pass all three; register is shared by both account types.
RATE_LIMIT_LOGIN_IP=10 per minute
RATE_LIMIT_LOGIN_IP_EMAIL=5 per minute
RATE_LIMIT_LOGIN_EMAIL=30 per hour
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_REFRESH=30 per minute
# One budget per user for every route that can call Groq (both parts apply).
RATE_LIMIT_LLM=10 per minute;100 per day
RATE_LIMIT_DOWNLOAD=60 per minute


# --- Groq LLM (optional) -----------------------------------------------------------
# Enables AI summaries, job-posting enhancement and score explanations.
# Free key: https://console.groq.com   If empty, those features fall back to
# rule-based output and nothing breaks.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.3
# Seconds one attempt may take.
GROQ_TIMEOUT_SECONDS=30
# Retries after the first attempt. One call can take (retries + 1) x timeout plus
# 1+2+4... s of waiting; the app refuses to start if that reaches
# GROQ_CALL_BUDGET_SECONDS.
GROQ_MAX_RETRIES=2
# The longest one request may spend on Groq. Keeps it under axios 110 s < gunicorn 115 s.
GROQ_CALL_BUDGET_SECONDS=100
# POST /applications/ makes up to two Groq calls inside one budget. The second (the
# improvement plan) is skipped when less than this many seconds are left.
GROQ_OPTIONAL_CALL_MIN_SECONDS=25


# --- Semantic embeddings ---------------------------------------------------------------
# sentence-transformers model for semantic resume-to-job matching. If it cannot load,
# semantic scoring reports unavailable and keyword/experience scoring still work.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=.cache/embeddings
# true = load the model from the cache only. The Docker image and render.yaml set it,
# because `python -m scripts.download_model` fetches the model at build time. Keep false
# for local development, where the first run downloads it (~90 MB).
EMBEDDING_OFFLINE=false
# Threads for torch/OpenMP. Keep 1: gunicorn preloads the model in the master and forks.
TORCH_NUM_THREADS=1


# --- ATS scoring weights ------------------------------------------------------------------
# All four MUST sum to 1.0 (the app refuses to start otherwise).
#   Semantic match   40%  cosine similarity of embeddings
#   Keyword match    35%  BM25 + exact overlap
#   Experience       15%  years, seniority, education bonus
#   Section quality  10%  completeness of resume sections
WEIGHT_SEMANTIC=0.40
WEIGHT_KEYWORD=0.35
WEIGHT_EXPERIENCE=0.15
WEIGHT_SECTION_QUALITY=0.10


# --- ATS score thresholds -------------------------------------------------------------------
#   excellent >= 0.80   good >= 0.65   fair >= 0.50   weak < 0.50
ATS_SCORE_THRESHOLD_EXCELLENT=0.80
ATS_SCORE_THRESHOLD_GOOD=0.65
ATS_SCORE_THRESHOLD_FAIR=0.50


# --- Recommendations ----------------------------------------------------------------------------
TOP_N_JOB_RECOMMENDATIONS=10
TOP_N_ROLE_SUGGESTIONS=4
TOP_N_CANDIDATES_PER_JOB=3


# --- Pagination --------------------------------------------------------------------------------------
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100


# --- Logging ------------------------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Production defaults to WARNING.
LOG_LEVEL=INFO
# text (readable, local development) | json (log aggregators, production default)
LOG_FORMAT=text
