# =============================================================================
# backend/.env.example — AI Resume Intelligence Platform (Flask API)
# =============================================================================
# SETUP:
#   cp backend.env.example .env
#   Fill in values, then: flask run  OR  docker compose up
#
# ⚠  NEVER commit your actual .env file to Git.
#    Add .env to .gitignore immediately.
# =============================================================================


# ─── Environment ──────────────────────────────────────────────────────────────
# Options: development | production | testing
APP_ENV=development


# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED. Used for session signing and CSRF protection.
# Generate a strong key:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# ✅ Local dev  → any random string is fine
# 🔴 Production → must be 64-char hex, stored in Render env vars, NEVER in code
SECRET_KEY=

# Token lifetimes. The access token is short because it cannot be revoked; the
# refresh cookie's Max-Age follows JWT_REFRESH_TTL_DAYS.
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7


# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5000

# Gunicorn worker count. Production defaults to 1: the app plus its embedding model
# measured 470-500 MB with one worker and 538 MB with two, against Render's 512 MB
# (docs/deploy_phase3.md). Development defaults to 2.
WORKERS=1
# Longest gunicorn lets a request run. The chain, innermost first:
#   one Groq call (GROQ_CALL_BUDGET_SECONDS 100) < axios 110 < this 115 < Vercel's proxy 120
GUNICORN_TIMEOUT_SECONDS=115


# ─── Database ─────────────────────────────────────────────────────────────────


# Development (local PostgreSQL via Docker Compose):
# DATABASE_URL=postgresql://postgres:ats_pass@127.0.0.1:5430/ats_db

DATABASE_URL=postgresql://postgres:ats_pass@localhost:5432/ats_db

# Production (Render auto-injects this when you attach a PostgreSQL database):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
#
# Note: Render may give you postgres:// — the app automatically rewrites it
# to postgresql:// for SQLAlchemy 2.x compatibility.

# Connection pool (leave defaults unless you know what you're doing)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30


# ─── CORS — Critical for Frontend ─────────────────────────────────────────────
# Comma-separated list of frontend origins allowed to call the API.
# Must exactly match the origin the browser sends (protocol + domain + port).
#
# ✅ Local dev:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 🔴 Production — replace with your actual Vercel/Netlify URL:
# ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com
#
# ⚠  Do NOT use wildcard (*) in production — it bypasses CORS protection.


# ─── Reverse proxy and refresh cookie ─────────────────────────────────────────
# Production sits behind Vercel (which proxies /api/v1/* to this app) and then
# Render's own proxy. TRUSTED_PROXY_HOPS is how many of them append to
# X-Forwarded-For; the client IP is the entry that many places from the right.
# Too low: every user shares one rate-limit bucket. Too high: a caller can
# choose their own bucket. 0 (local development) ignores the header.
# Production default: 2. Verify it after the first deploy (docs/deploy_phase3.md).
TRUSTED_PROXY_HOPS=0
# TEMPORARY: log the forwarded chain on each login so the hop count can be
# checked against the real deployment. Remove once verified.
LOG_PROXY_CHAIN=false
# The refresh cookie's Secure flag. Production default: true. Local development
# over plain http needs false (the development default).
REFRESH_COOKIE_SECURE=false


# ─── File Uploads ─────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads/
# Maximum file size in megabytes
MAX_UPLOAD_MB=10
# Allowed file extensions (comma-separated, no dots)
ALLOWED_EXTENSIONS=pdf,docx

# Development
STORAGE_PROVIDER=local

# Production (Render): all three credentials are required, or the app
# refuses to start.
# STORAGE_PROVIDER=cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Rate limiting ────────────────────────────────────────────────────────────
# Limits are per caller: the user id from the access token, else the client IP.
# memory:// keeps counters per process and is fine for local development.
# Production needs a shared store, e.g. redis://:password@host:6379/0 —
# with memory:// the app refuses to start.
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMIT_DEFAULT=200 per minute
# Login must pass all three; register is shared by both account types.
RATE_LIMIT_LOGIN_IP=10 per minute
RATE_LIMIT_LOGIN_IP_EMAIL=5 per minute
RATE_LIMIT_LOGIN_EMAIL=30 per hour
RATE_LIMIT_REGISTER=10 per hour
RATE_LIMIT_REFRESH=30 per minute
# One budget per user for every route that can call Groq (both parts apply).
RATE_LIMIT_LLM=10 per minute;100 per day
RATE_LIMIT_DOWNLOAD=60 per minute


# ─── Groq LLM (Optional) ──────────────────────────────────────────────────────
# Enables AI-powered job description enhancement and resume analysis.
# Get a free key at: https://console.groq.com
# If left empty, all LLM features fall back gracefully to rule-based logic.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.3
GROQ_TIMEOUT_SECONDS=30
# Retries after the first attempt. One call can take (retries + 1) x timeout plus
# 1+2+4... s of waiting; the app refuses to start if that reaches the 100 s budget
# (GROQ_CALL_BUDGET_SECONDS), which keeps it under axios 110 s < gunicorn 115 s.
GROQ_MAX_RETRIES=2


# ─── Semantic Embeddings (Optional) ───────────────────────────────────────────
# sentence-transformers model for semantic resume ↔ job matching.
# If unavailable, semantic scoring degrades to 0.0 (keyword + experience
# scoring still work normally).
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=.cache/embeddings
# true = load the model from the cache only (set in the Docker image and render.yaml,
# where `python -m scripts.download_model` fetches it at build time).
EMBEDDING_OFFLINE=false
# Threads for torch/OpenMP. Keep 1: gunicorn preloads the model in the master and forks.
TORCH_NUM_THREADS=1


# ─── ATS Scoring Weights ──────────────────────────────────────────────────────
# All four weights MUST sum to exactly 1.0.
# Default breakdown:
#   Semantic match   40% — cosine similarity of embeddings
#   Keyword match    35% — BM25 + exact overlap
#   Experience       15% — years, seniority, education bonus
#   Section quality  10% — completeness of resume sections
WEIGHT_SEMANTIC=0.40
WEIGHT_KEYWORD=0.35
WEIGHT_EXPERIENCE=0.15
WEIGHT_SECTION_QUALITY=0.10


# ─── ATS Score Thresholds ─────────────────────────────────────────────────────
# Labels displayed in the UI:
#   excellent  ≥ 0.80   (strong match — green)
#   good       ≥ 0.65   (worth reviewing — blue)
#   fair       ≥ 0.50   (partial match — amber)
#   weak       < 0.50   (poor match — red)
ATS_SCORE_THRESHOLD_EXCELLENT=0.80
ATS_SCORE_THRESHOLD_GOOD=0.65
ATS_SCORE_THRESHOLD_FAIR=0.50


# ─── Recommendations ──────────────────────────────────────────────────────────
TOP_N_JOB_RECOMMENDATIONS=10
TOP_N_ROLE_SUGGESTIONS=4
TOP_N_CANDIDATES_PER_JOB=3


# ───────────── Resume Builder ────────────────────────────────────────────────

BUILDER_TARGET_SCORE=0.75   

# ── Pagination ───────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100


# ─── Logging ──────────────────────────────────────────────────────────────────
# Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Format: text (human-readable local dev) | json (for log aggregators in prod)
LOG_FORMAT=text
